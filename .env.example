DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=jobportal
DB_PASSWORD=jobportal
DB_NAME=jobportal
# Set to true to log SQL during migrations
DB_LOGGING=false

NODE_ENV=development
PORT=3000
# Optional: overrides DB_* when set (e.g. cloud managed Postgres)
# DATABASE_URL=postgresql://jobportal:jobportal@localhost:5432/jobportal

# Set true only for local dev without migrations; production should use migrations
TYPEORM_SYNC=false

JWT_SECRET=change-me-access-secret-min-32-chars-long!!
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars!!
# Access token TTL; JWT_ACCESS_EXPIRES_IN takes precedence over JWT_EXPIRES_IN
JWT_ACCESS_EXPIRES_IN=15m
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
